# COCO images and annotation files (downloaded by data.py)
data/coco/

# large generated attack PNGs (regenerated by: run.py --stage attack);
# the small audit files results/adv/*/attack_info.csv and meta.json are tracked
results/adv/**/*.png

# backups
backups/

# environment, caches, model weights (downloaded automatically)
.venv/
__pycache__/
weights/
# model weights
*.pt
*.pth
*.onnx

# ultralytics output
runs/

# secrets
.env

# editor / OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db

# python / notebook junk
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
*.pyc
# Phase 1 attacked PNGs (kept only at eps_min; regenerated by run.py --stage phase1)
results/phase1/adv/

# Phase 1b attacked PNGs (regenerated by run.py --stage phase1b)
results/phase1b/adv/

# Confirmatory attacked PNGs (regenerated by run.py --stage confirmatory)
results/confirmatory/adv/

# Kaggle upload bundle (built with git archive from committed files)
kaggle_code.zip

# Confirmatory code-test outputs (--manifest test option); never committed
results/confirmatory/*_test_only*
results/confirmatory/*_test_only*/
